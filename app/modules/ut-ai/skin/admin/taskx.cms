<{include "$pubtemp/head.cms"}> 
    <div class="main-panel">
        <div class="content">
            <div class="page-inner">
                <div class="page-header">
                    <h4 class="page-title"><{$title}></h4>
                    <ul class="breadcrumbs">
                        <li class="nav-home"><a href="./"><i class="fa fa-home"></i></a></li>
                        <li class="separator"><i class="fa fa-angle-double-right"></i></li>
                        <li class="nav-item"><a href="<{url=>Link($module)}>">AI能力</a></li>
                        <li class="separator"><i class="fa fa-angle-double-right"></i></li>
                        <li class="nav-item"><a href="<{url=>Link($module,'task')}>">AI任务</a></li>
                        <li class="separator"><i class="fa fa-angle-double-right"></i></li>
                        <li class="nav-item"><{if $task["id"]>0}>编辑 #<{$task->id}><{else}>创建任务<{/if}></li>
                    </ul>
                </div>
                <form method="post" action="<{url=>Link($module,'taskx','do=save')}>">
                <input type="hidden" name="id" value="<{$task->id}>">
                <div class="card">
                    <div class="card-header"><h4 class="card-title">任务内容</h4></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>任务标题</label>
                                <input type="text" name="title" class="form-control" value="<{$task->title}>" placeholder="如：每日新闻摘要（留空自动取 prompt 前 30 字）">
                            </div>
                            <div class="col-md-6 form-group">
                                <label>任务类型</label>
                                <select name="task_type" id="task_type" class="form-control">
                                    <option value="text" <{if $task["task_type"]=="text"}>selected<{/if}>>生文（对话 / 写作）</option>
                                    <option value="image" <{if $task["task_type"]=="image"}>selected<{/if}>>生图（图片生成）</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>执行模型</label>
                                <select name="model" class="form-control">
                                    <option value="">默认（生文用 INDEX_MODEL，生图用 IMAGE_MODEL）</option>
                                    <{loop=>$allowed_models $m}>
                                    <option value="<{$m}>" <{if $task["model"]==$m}>selected<{/if}>><{$m}></option>
                                    <{/loop}>
                                </select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label>状态</label>
                                <select name="state" class="form-control">
                                    <option value="0" <{if $task["state"]==0}>selected<{/if}>>草稿</option>
                                    <option value="1" <{if $task["state"]==1}>selected<{/if}>>就绪</option>
                                    <option value="2" <{if $task["state"]==2}>selected<{/if}>>执行中</option>
                                    <option value="3" <{if $task["state"]==3}>selected<{/if}>>成功</option>
                                    <option value="4" <{if $task["state"]==4}>selected<{/if}>>失败</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>是否写表</label>
                                <select name="write_db" id="write_db" class="form-control">
                                    <option value="0" <{if $task["write_db"]!=1}>selected<{/if}>>否（仅返回结果）</option>
                                    <option value="1" <{if $task["write_db"]==1}>selected<{/if}>>是（写入数据表）</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group" id="target_table_box">
                                <label>目标表</label>
                                <select name="target_table" class="form-control">
                                    <option value="">请选择（仅限 ut-api 白名单表）</option>
                                    <{loop=>$open_tables $t}>
                                    <option value="<{$t}>" <{if $task["target_table"]==$t}>selected<{/if}>><{$t}></option>
                                    <{/loop}>
                                </select>
                            </div>
                            <div class="col-md-4 form-group" id="image_count_box"<{if $task["task_type"]!="image"}> style="display:none"<{/if}>>
                                <label>生成张数（生图）</label>
                                <input type="number" name="image_count" class="form-control" min="1" max="10" value="<{$task->image_count}>">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>是否定时循环</label>
                                <select name="is_cron" id="is_cron" class="form-control">
                                    <option value="0" <{if $task["is_cron"]!=1}>selected<{/if}>>否（按就绪状态执行）</option>
                                    <option value="1" <{if $task["is_cron"]==1}>selected<{/if}>>是（每日定时执行）</option>
                                </select>
                            </div>
                            <div class="col-md-6 form-group" id="cron_time_box">
                                <label>每日执行时间</label>
                                <input type="time" name="cron_time" class="form-control" value="<{$task->cron_time}>">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>主提示词 Prompt（必填）</label>
                                <textarea name="prompt" class="form-control" rows="5" required placeholder="如：请根据以下内容生成每日简报..."><{$task->prompt}></textarea>
                            </div>
                            <div class="col-md-6 form-group">
                                <label>上下文 Context（可选）</label>
                                <textarea name="context" class="form-control" rows="5" placeholder="如文章原文、关键词列表..."><{$task->context}></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>高级参数 Options（JSON 可选）</label>
                            <input type="text" name="options" class="form-control" value="<{$task->options}>" placeholder="如 {&quot;temperature&quot;:0.7}，留空使用上游默认">
                        </div>
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary btn-round"><{if $task["id"]>0}>保存修改<{else}>创建任务<{/if}></button>
                            <a href="<{url=>Link($module,'task')}>" class="btn btn-default btn-round">返回</a>
                        </div>
                    </div>
                </div>
                </form>
                <script>
                (function(){
                    function bind(selId,boxId){
                        var sel=document.getElementById(selId);
                        var box=document.getElementById(boxId);
                        if(!sel||!box){return;}
                        function sync(){box.style.display=sel.value==="1"?"":"none";}
                        sel.addEventListener("change",sync);
                        sync();
                    }
                    bind("write_db","target_table_box");
                    bind("is_cron","cron_time_box");
                    var type=document.getElementById("task_type");
                    var countBox=document.getElementById("image_count_box");
                    if(type&&countBox){
                        function syncCount(){countBox.style.display=type.value==="image"?"":"none";}
                        type.addEventListener("change",syncCount);
                        syncCount();
                    }
                })();
                </script>
            </div>
        </div>
    </div>
<{include "$pubtemp/foot.cms"}>
