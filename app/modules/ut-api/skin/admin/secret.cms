<{include "$pubtemp/head.cms"}>
    <div class="main-panel">
        <div class="content">
            <div class="page-inner">
                <div class="page-header">
                    <h4 class="page-title"><{$title}></h4>
                    <ul class="breadcrumbs">
                        <li class="nav-home">
                            <a href="./">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="separator">
                            <i class="fa fa-angle-double-right"></i>
                        </li>
                        <li class="nav-item">
                            <a href="<{url=>Link($module)}>"><{$title}></a>
                        </li>
                        <li class="separator">
                            <i class="fa fa-angle-double-right"></i>
                        </li>
                        <li class="nav-item">
                            Secret票据
                        </li>
                        <li class="nav-item">
                            <{item=>$module,$backitem}>
                        </li>
                    </ul>
                </div>
                <div class="card">
                    <div class="card-body">
                        <p class="border-bottom">票据有效期 300 秒，超过有效期或使用过再次使用均为非法。</p>
                        <div class="table-responsive" id="ut-auto">
                            <table class="display table table-striped table-hover" id="ut-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>AppID</th>
                                        <th>Secret</th>
                                        <th>IP</th>
                                        <th>生成时间</th>
                                        <th>使用时间</th>
                                        <th>状态</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <{if empty($datalist)}>
                                    <tr>
                                        <td colspan="7">暂无日志</td>
                                    </tr>
                                    <{/if}>
                                    <{loop=>$datalist $rows}>
                                    <tr>
                                        <td><{$rows->id}></td>
                                        <td class="text-nowrap"><{$rows->appid}></td>
                                        <td><{$rows->secret}></td>
                                        <td class="text-nowrap"><{$rows->ip}></td>
                                        <td><{$rows->addtime}></td>
                                        <td><{$rows->usetime}></td>
                                        <td><{$rows->state}></td>
                                    </tr>
                                    <{/loop}>
                                </tbody>
                            </table>
                        </div>
                        <{page=>total,curpage,listnum,pagelink}>
                    </div>
                </div>
            </div>
        </div>
    </div>
<{include "$pubtemp/foot.cms"}>