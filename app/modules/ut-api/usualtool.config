<?xml version='1.0' encoding='UTF-8'?>
<mod>
<id>ut-api</id>
<type>3</type>
<auther>官方</auther>
<title>接口</title>
<ver>6.0</ver>
<description>适用于远程获取数据的Api接口，支持APP、网页等应用。</description>
<itemid>3</itemid>
<sorting>2</sorting>
<starturl>index.php</starturl>
<befoitem>NULL</befoitem>
<backitem>接口配置:index.php,应用密钥:app.php,在线调试:test.php,Secret票据:secret.php,通行日志:pass.php</backitem>
<installsql><![CDATA[DROP TABLE IF EXISTS `cms_api`;
CREATE TABLE `cms_api` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `token` varchar(250) DEFAULT NULL,
  `white` text,
  `opentable` text,
  `protect` text,
  PRIMARY KEY (`id`),
  UNIQUE KEY `id` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `cms_api_app`;
CREATE TABLE `cms_api_app` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `appid` varchar(100) NOT NULL,
  `appsecret` varchar(100) NOT NULL,
  `status` int(11) DEFAULT 1,
  `bindip` varchar(200) DEFAULT NULL,
  `remark` varchar(200) DEFAULT NULL,
  `addtime` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `appid` (`appid`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `cms_api_nonce`;
CREATE TABLE `cms_api_nonce` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `appid` varchar(100) NOT NULL,
  `nonce` varchar(64) NOT NULL,
  `addtime` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `appid_nonce` (`appid`,`nonce`),
  KEY `addtime` (`addtime`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `cms_api_secret`;
CREATE TABLE `cms_api_secret` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `appid` varchar(100) DEFAULT NULL,
  `secret` varchar(100) DEFAULT NULL,
  `addtime` datetime DEFAULT NULL,
  `usetime` datetime DEFAULT NULL,
  `ip` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `secret` (`secret`),
  KEY `addtime` (`addtime`),
  KEY `ip_addtime` (`ip`,`addtime`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `cms_api_log`;
CREATE TABLE `cms_api_log` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `act` varchar(50) DEFAULT NULL,
  `utable` varchar(100) DEFAULT NULL,
  `usecret` varchar(100) DEFAULT NULL,
  `uwhere` varchar(500) DEFAULT NULL,
  `udata` text,
  `ip` varchar(100) DEFAULT NULL,
  `addtime` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `addtime` (`addtime`),
  KEY `act` (`act`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
INSERT INTO `cms_api` VALUES (1,NULL,NULL,NULL,'password');]]></installsql>
<uninstallsql><![CDATA[DROP TABLE `cms_api`;DROP TABLE `cms_api_app`;DROP TABLE `cms_api_nonce`;DROP TABLE `cms_api_secret`;DROP TABLE `cms_api_log`;]]></uninstallsql>
</mod>