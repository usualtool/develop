<!DOCTYPE html>
<html>
<head>
    <title><{$webplace}> - <{$appname}></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="<{$appurl}>/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="<{$appurl}>/assets/css/fontawesome.min.css" rel="stylesheet">
    <link href="<{$appurl}>/assets/css/default.css" rel="stylesheet">
    <script src="<{$appurl}>/assets/js/jquery.min.js"></script>
    <script src="<{$appurl}>/assets/js/popper.min.js"></script>
    <script src="<{$appurl}>/assets/js/bootstrap.min.js"></script>
</head>
<body>
    <header class="ut-header">
        <div class="ut-header-in">
            <a class="ut-brand" href="<{$appurl}>"><img src="<{$appurl}>/assets/logo.png" alt="logo"></a>
            <a class="ut-search-btn" href="<{url=>Link("ut-frame","search")}>" aria-label="搜索">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2.5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="15.5" y1="15.5" x2="21" y2="21"/></svg>
            </a>
            <div class="right">
                <a data-toggle="dropdown" href="javascript:void(0);" class="text-dark"><i class="fa fa-language" aria-hidden="true"></i> <{lang=>lg}></a>
                <div class="dropdown-menu">
                    <{loop=>$lang $row}>
                    <a class="dropdown-item" href="javascript:void(0);" onclick="clicklang('<{$row}>')">
                        <{lang=>set->speak,return=>$row}>
                    </a>
                    <{/loop}>
                </div>
            </div>
        </div>
    </header>
